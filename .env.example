ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_NAME=Jarvis
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
PORT=3000
# Optional: point at a persistent volume's mount path on your host (e.g. /data)
# so conversation history survives redeploys. Leave unset for local runs.
DATA_DIR=
# Optional: use Upstash Redis (free tier) for conversation memory instead of a
# local file — needed on hosts with no persistent disk, like Render's free tier.
# Get these from your Upstash database's REST API section. If both are unset,
# the app falls back to the local file / DATA_DIR above.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
